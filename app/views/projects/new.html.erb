<br />
<div class="row">
  <div class="four columns">
  </div>

  <div class="four columns">
    <h1>New Project</h1>
      <p><%= link_to :Back, :back %></p>
      <%= form_for @project, html: {multipart: true} do |f| %>
        <div id="project-form-errors">
          <% if @project.errors.any? %>
            <%= render 'projects/errors' %>
          <% end %>
        </div>
        <div class="field">
          <%= f.label :title %><br />
          <%= f.text_field :title, placeholder: 'Your Next Gen Brain Wave Entrainment ... ' %>
        </div>
        <div class="field">
          <%= f.label :description %><br />
          <%= f.text_area :description, placeholder: 'Be able to measure your brain state and change it accordingly with our software and hardware ... ' %>
        </div>
        <div class="field">
          <%= f.label :funding_goal %><br />
          <%= f.text_field :funding_goal, placeholder: '$6,000,000' %>
        </div>

        <div class="field">
          <%= f.file_field :image, class: 'button' %>
        </div>

        <p>Rewards: </p>
        <div class='each-breakpoint'>
          <%= f.fields_for :breakpoints do |p|  %>
            <%= render 'breakpoint_fields', :f => p %>
          <% end %>
          <%= link_to_add_association 'Add', f, :breakpoints %>
        </div>

        <div class="actions">
          <%= f.submit 'Save', class: 'button' %>
        </div>
      <% end %>
  </div>

  <div class="four columns">
  </div>
</div>