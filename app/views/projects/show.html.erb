<div class="row">
  <div class="four columns"></div>

  <p><%= link_to "Back to projects", :back %></p>

  <div class="four columns center">
    <h1><%= @project.title %></h1>
    <section>
      <%= @project.description.html_safe %>
    </section>
    <%= image_tag @project.image.url(:medium) %>

    <h2>Comments</h2>
    <%= render "comments/comments" %>
    <h2>New Comment</h2>
    <%= render "comments/form" %>
  </div>

  <div class="four columns"></div>
</div>