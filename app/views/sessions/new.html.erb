<div class="row">
  <div class="four columns">
  </div>
  <div class="four columns">
    <%= form_tag sessions_path do %>
      <fieldset>
        <legend><h2>Log In</h2></legend>
        <div class="field">
          <%= text_field_tag :email, params[:email], placeholder: "Email" %>
        </div>
        <div class="field">
          <%= password_field_tag :password %>
        </div>
        <div class="actions">
          <%= submit_tag "Log in", class: 'button' %>
        </div>
        <%= link_to("Back", :back) %>
      </fieldset>
    <% end %>
  </div>
  <div class="four columns">
  </div>
</div>