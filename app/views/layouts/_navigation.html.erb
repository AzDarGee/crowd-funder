<div>

  <nav class="top-bar" data-topbar>
    <ul class="title-area">
      <li class="name">
        <h1><%= link_to "CrowdFunder", root_path %></h1>
      </li>
      <li class="toggle-topbar menu-icon">
        <%= link_to "Menu", '#' %>
      </li>
    </ul>

    <section class="top-bar-section">
      <ul class="left">
        <li class="has-form">
          <div class="row collapse">
            <div class="large-8 small-9 columns">
              <input type="text" placeholder="Discover Projects">
            </div>
            <div class="large-4 small-3 columns">
              <%= link_to 'Find', '#', class: 'button expand' %>
            </div>
          </div>
        </li>
      </ul>
      <ul class="right">
        <% if current_user %>
          <li class="has-dropdown"><%= link_to current_user.name, '#' %>
            <ul class="dropdown">
              <%= link_to "Log out", session_path("current"), method: :delete %>
            </ul>
          </li>
        <% else %>
          <li><%= link_to "Sign in", new_session_path %></li>
          <li><%= link_to "Register", user_path %></li>
        <% end %>
      </ul>
    </section>

  </nav>

</div>



