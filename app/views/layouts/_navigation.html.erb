<div class="icon-bar five-up">
  <% if current_user %>
    <%= link_to current_user.name, root_path, class: "item" %>
    <%= link_to 'Two', '#', class: 'item' %>
    <%= link_to 'Three', '#', class: 'item' %>
    <%= link_to 'Four', '#', class: 'item' %>
    <%= link_to "Log out", session_path("current"), method: :delete, class: "item" %>

  <% else %>

    <%= link_to 'One', root_path, class: 'item' %>
    <%= link_to 'Two', '#', class: 'item' %>
    <%= link_to 'Three', '#', class: 'item' %>
    <%= link_to 'Sign up', user_path, class: 'item' %>
    <%= link_to "Log in", login_path, class: 'item' %>
  <% end %>
</div>



